<Window x:Class="Vonvert.App.FullscreenVisualizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Vonvert.App.UIServices"
        xmlns:vc="clr-namespace:Vonvert.App.Controls"
        Title="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=AppName}"
        Width="1280" Height="720" MinWidth="640" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Black"
        ResizeMode="CanResize" Topmost="True"
        WindowStartupLocation="CenterScreen" Cursor="None">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="MainRow"    Height="*"/>
            <RowDefinition x:Name="WaveRow"    Height="140"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MainCol"  Width="*"/>
            <ColumnDefinition x:Name="LufsCol"  Width="150"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Waterfall pane (main view, pitch overlay) ══ -->
        <Border x:Name="WaterfallPanel" Grid.Row="0" Grid.Column="0" Background="Black"
                PreviewMouseLeftButtonDown="WaterfallPanel_DoubleClick">
            <Grid>
                <Image x:Name="WaterfallImage" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="Linear"/>
                <!-- frequency / time labels drawn over the picture in view space, so they
                     stay crisp and scale with the window instead of being baked into the
                     200x128 bitmap. IsHitTestVisible=False keeps drag and double-click on
                     the panel itself. -->
                <Canvas x:Name="AxisCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0">
                    <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsSpectrogramLabel, Mode=OneWay}"
                           FontSize="13" Foreground="#CCFFFFFF"/>
                    <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsSpectrogramSub, Mode=OneWay}"
                           FontSize="10" Foreground="#99FFFFFF" Margin="0,1,0,0"/>
                </StackPanel>
                <!-- pitch badges: solid dark plates with a colored rim. The note color is
                     set per deviation (green/amber/red), so the plate has to stay dark and
                     opaque - purple text on a purple wash was unreadable once captured. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,20,0">
                    <Border x:Name="FsPitchNoteBadge" CornerRadius="8" Padding="14,6" Background="#E61B1631"
                            BorderBrush="#808B5CF6" BorderThickness="1" Margin="0,0,10,0" Visibility="Collapsed">
                        <vc:SelectableTextBlock x:Name="FsPitchNoteText" Text="—" FontSize="36" FontWeight="Bold" Foreground="#DDFFFFFF"/>
                    </Border>
                    <Border x:Name="FsPitchCentsBadge" CornerRadius="8" Padding="10,6" Background="#E6101A24"
                            BorderBrush="#803EC6FF" BorderThickness="1" Margin="0,0,10,0" Visibility="Collapsed">
                        <vc:SelectableTextBlock x:Name="FsPitchCentsText" Text="0 cents" FontSize="20" Foreground="#BB3EC6FF" VerticalAlignment="Center"/>
                    </Border>
                    <vc:SelectableTextBlock x:Name="FsPitchFreqText" Text="" FontSize="16" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- pitch curve + cents meter (bottom overlay inside the pane) -->
                <Canvas x:Name="PitchCurveCanvas" Height="80" VerticalAlignment="Bottom" Background="#08080E" ClipToBounds="True"/>
                <Canvas x:Name="FsCentsMeterCanvas" Height="8" VerticalAlignment="Bottom" Margin="30,0,30,84" ClipToBounds="True" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ══ Loudness pane (vertical LUFS meter) ══ -->
        <Border x:Name="LoudnessPanel" Grid.Row="0" Grid.Column="1" Background="#0A0C12"
                BorderBrush="#22FFFFFF" BorderThickness="1,0,0,0"
                PreviewMouseLeftButtonDown="LoudnessPanel_DoubleClick">
            <Grid Margin="10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsLoudnessLabel, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#CCFFFFFF"/>
                    <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsLoudnessSub, Mode=OneWay}" FontSize="10" Foreground="#99FFFFFF" Margin="0,1,0,0"/>
                </StackPanel>
                <Canvas x:Name="LufsCanvas" Grid.Row="1" ClipToBounds="True"
                        ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsTargetLufs, Mode=OneWay}"/>
                <StackPanel Grid.Row="2">
                    <vc:SelectableTextBlock x:Name="LufsTruePeakText" Text="TP -∞" FontSize="12" Foreground="#CCFFFFFF" Margin="0,6,0,0"/>
                    <vc:SelectableTextBlock x:Name="LufsIntegratedText" Text="I -∞" FontSize="12" Foreground="#BB3EC6FF" Margin="0,2,0,0">
                        <vc:SelectableTextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ResetIntegratedItem" Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsResetIntegrated, Mode=OneWay}" Click="ResetIntegrated_Click"/>
                            </ContextMenu>
                        </vc:SelectableTextBlock.ContextMenu>
                    </vc:SelectableTextBlock>
                    <!-- The integrated reading restarts from a right-click on the text above, which
                         nobody discovers. Same action, visible button (keeps the menu for muscle memory). -->
                    <Button x:Name="ResetIntegratedBtn" Style="{StaticResource SegmentButton}" FontSize="10" Padding="8,2"
                            HorizontalAlignment="Left" Margin="0,4,0,0" Click="ResetIntegrated_Click"
                            Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsResetIntegrated, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Waveform pane (dry/wet) ══ -->
        <Border x:Name="WaveformPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#0A0C12"
                BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0"
                PreviewMouseLeftButtonDown="WaveformPanel_DoubleClick">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="12,8,0,8" VerticalAlignment="Top">
                    <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsWaveformLabel, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#CCFFFFFF"/>
                    <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsWaveformSub, Mode=OneWay}" FontSize="10" Foreground="#99FFFFFF" Margin="0,1,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="DryBtn" Style="{StaticResource SegmentButton}" Padding="10,3" Margin="0,0,6,0" Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsDryLabel, Mode=OneWay}" Click="DryBtn_Click"/>
                        <Button x:Name="WetBtn" Style="{StaticResource SegmentButton}" Padding="10,3" Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsWetLabel, Mode=OneWay}" Click="WetBtn_Click"/>
                    </StackPanel>
                    <!-- which signal this really is, in words: the two taps are small and
                         their tint difference is invisible once the window is downscaled -->
                    <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=MonitorSourceLabel, Mode=OneWay}"
                           FontSize="10" Foreground="#99FFFFFF" Margin="0,6,0,0"/>
                </StackPanel>
                <Canvas x:Name="WaveformCanvas" Grid.Column="1" Margin="8" ClipToBounds="True"/>
            </Grid>
        </Border>

        <!-- preset-name fade overlay (spans both rows so it survives any maximize state) -->
        <vc:SelectableTextBlock x:Name="PresetNameOverlay" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
               FontSize="48" FontWeight="Bold"
               Foreground="#AA8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
            <vc:SelectableTextBlock.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/></vc:SelectableTextBlock.Effect>
        </vc:SelectableTextBlock>

        <!-- close hint (revealed on mouse move). Bottom-left: it used to sit 160 px in from
             the right to dodge the LUFS column, which put it exactly where the pitch badge
             row lands as soon as somebody speaks, and the top-left now carries the waterfall
             title. Bottom-right belongs to the chrome toolbar. -->
        <Border x:Name="CloseHint" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Margin="10,0,0,10"
                Background="#99000000" CornerRadius="0,12,0,0" Padding="16,8" Opacity="0">
            <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=EscToClose, Mode=OneWay}" FontSize="12" Foreground="#CCFFFFFF"/>
        </Border>

        <!-- ══ guidance band: the one sentence that stops a frozen or black picture being
             read as a crash. Wording is bound, so it follows the UI language. ══ -->
        <Border x:Name="GuidanceBand" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0"
                Background="#CC3A2A10" BorderBrush="#66FBBF24" BorderThickness="1"
                CornerRadius="10" Padding="14,8" MaxWidth="620"
                Visibility="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=MonitorGuidanceVisible, Mode=OneWay, Converter={StaticResource B2V}}">
            <TextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=MonitorGuidanceText, Mode=OneWay}"
                       FontSize="13" Foreground="#F4E3C4" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>

        <!-- ══ chrome toolbar: revealed with the cursor on mouse move, hidden after the same
             3s idle beat. Words rather than glyphs: a first-time streamer must read "Close",
             not guess an icon, and it costs no new icon assets. Bottom-right is the only corner
             with no label of its own, so the strip never writes over a panel title. -->
        <Border x:Name="ChromeBar" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Background="#CC0A0C12" BorderBrush="#33FFFFFF" BorderThickness="1,1,0,0"
                CornerRadius="12,0,0,0" Padding="8,6" Opacity="0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CloseBtn" Style="{StaticResource SegmentButton}" FontSize="11" Padding="10,4"
                        Click="CloseBtn_Click"
                        Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsClose, Mode=OneWay}"/>
                <Button x:Name="TopmostBtn" Style="{StaticResource SegmentButton}" FontSize="11" Padding="10,4"
                        Click="TopmostBtn_Click"
                        Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsTopmost, Mode=OneWay}"/>
                <Button x:Name="SizeBtn" Style="{StaticResource SegmentButton}" FontSize="11" Padding="10,4"
                        Click="SizeBtn_Click"
                        Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsSize, Mode=OneWay}"/>
                <Button x:Name="ResetViewBtn" Style="{StaticResource SegmentButton}" FontSize="11" Padding="10,4"
                        Click="ResetViewBtn_Click"
                        Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsRestoreLayout, Mode=OneWay}"/>
                <Button x:Name="LabelModeBtn" Style="{StaticResource SegmentButton}" FontSize="11" Padding="10,4"
                        Click="LabelModeBtn_Click"
                        Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsLabelModeLabel, Mode=OneWay}"/>
                <Button x:Name="HelpBtn" Style="{StaticResource SegmentButton}" FontSize="11" Padding="10,4"
                        Click="HelpBtn_Click"
                        Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsHelpBtn, Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <!-- ══ help card: the gestures that used to be invisible, written down ══ -->
        <Popup x:Name="HelpPopup" PlacementTarget="{Binding ElementName=HelpBtn}" Placement="Top"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="#F20A0C12" BorderBrush="#44FFFFFF" BorderThickness="1"
                    CornerRadius="12" Padding="16,12" MaxWidth="420">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#EEFFFFFF" Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsHelpTitle, Mode=OneWay}"/>
                    <TextBlock FontSize="12" Foreground="#EE3EC6FF" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsHelpFocus, Mode=OneWay}"/>
                    <TextBlock FontSize="12" Foreground="#DDFFFFFF" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsHelpDrag, Mode=OneWay}"/>
                    <TextBlock FontSize="12" Foreground="#DDFFFFFF" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsHelpDblClick, Mode=OneWay}"/>
                    <TextBlock FontSize="12" Foreground="#DDFFFFFF" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsHelpRightClick, Mode=OneWay}"/>
                    <TextBlock FontSize="12" Foreground="#DDFFFFFF" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=EscToClose, Mode=OneWay}"/>
                    <!-- full guide, published on the web so it renders as a page -->
                    <TextBlock FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap">
                        <Hyperlink x:Name="GuideLink" Click="GuideLink_Click" Foreground="{DynamicResource Accent}"><Run Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsGuideLink, Mode=OneWay}"/></Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Popup>

        <!-- first-run walkthrough: the main window's spotlight control, given this window's
             own copy and its own marker file so the two tours cannot cancel each other -->
        <vc:TourOverlay x:Name="MonitorTour" Panel.ZIndex="300"/>
    </Grid>
</Window>
