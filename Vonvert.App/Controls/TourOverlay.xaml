<UserControl x:Class="Vonvert.App.Controls.TourOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vonvert.App.UIServices"
             xmlns:vc="clr-namespace:Vonvert.App.Controls"
             Visibility="Collapsed">
    <Canvas x:Name="TourCanvas" Panel.ZIndex="200"
            MouseLeftButtonDown="TourOverlay_Click">
        <Rectangle x:Name="TourDimTop"    Fill="#B2000000" Width="0" Height="0"/>
        <Rectangle x:Name="TourDimBottom" Fill="#B2000000" Width="0" Height="0"/>
        <Rectangle x:Name="TourDimLeft"   Fill="#B2000000" Width="0" Height="0"/>
        <Rectangle x:Name="TourDimRight"  Fill="#B2000000" Width="0" Height="0"/>
        <Border x:Name="TourHighlight" CornerRadius="14" BorderThickness="2.5"
                BorderBrush="{DynamicResource Accent}" Background="#118B5CF6">
            <Border.Effect>
                <DropShadowEffect Color="#8B5CF6" BlurRadius="22" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>
        </Border>
        <Border x:Name="TourBubble" CornerRadius="12" Padding="16,12" MaxWidth="340"
                Background="{DynamicResource SurfaceLift}"
                BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel>
                <vc:SelectableTextBlock x:Name="TourStepTitle" Text="" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource Accent}"
                           FontFamily="{StaticResource FontFallback}" Margin="0,0,0,5"/>
                <vc:SelectableTextBlock x:Name="TourStepBody" Text="" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"
                           FontFamily="{StaticResource FontFallback}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="TourSkipBtn" Style="{StaticResource OutlineButton}"
                            Padding="12,4" Margin="0,0,8,0" FontSize="11"
                            Click="TourSkip_Click"
                            Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=OnbSkip}"
                            FontFamily="{StaticResource FontFallback}"/>
                    <Button x:Name="TourNextBtn" Padding="14,4" FontSize="11" FontWeight="Bold"
                            Click="TourNext_Click"
                            Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=OnbNext}"
                            FontFamily="{StaticResource FontFallback}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Canvas>
</UserControl>
