<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═════════════════════ VONVERT BRAND MARK (V + arcs, compact) ═════════════════════ -->
    <PathGeometry x:Key="GeoBrandV" Figures="M4.875 5.5 L6.875 5.5 L8 9.625 L9.125 5.5 L11.125 5.5 L8.875 13.75 L7.125 13.75 Z"/>
    <DrawingImage x:Key="VM_BrandMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.ClipGeometry>
                    <RectangleGeometry Rect="0,0,16,16"/>
                </DrawingGroup.ClipGeometry>
                <!-- Bold V letterform (same brush source as the arcs so the
                     whole mark always recolors as one under any theme) -->
                <GeometryDrawing Brush="{DynamicResource TextPrimary}"
                                 Geometry="{DynamicResource GeoBrandV}"/>
                <!-- Inner sound arc -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource TextPrimary}" Thickness="0.9" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 6.85 3.0 A 1.625 1.625 0 0 1 9.15 3.0"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Outer sound arc -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource TextPrimary}" Thickness="0.65" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 6.15 4.0 A 2.625 2.625 0 0 1 9.85 4.0"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <!-- ═════════════════════ VONVERT BRAND LOGO (V + sound arcs) ═════════════════════ -->
    <DrawingImage x:Key="VM_Logo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.ClipGeometry>
                    <RectangleGeometry Rect="0,0,64,64"/>
                </DrawingGroup.ClipGeometry>
                <!-- Squircle background: violet -> magenta -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF6D28D9" Offset="0"/>
                            <GradientStop Color="#FF8B5CF6" Offset="0.55"/>
                            <GradientStop Color="#FFDB2777" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="14" RadiusY="14" Rect="3,3,58,58"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Soft top-left light -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush GradientOrigin="0.25,0.15" Center="0.25,0.15" RadiusX="0.6" RadiusY="0.6">
                            <GradientStop Color="#30FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="14" RadiusY="14" Rect="3,3,58,58"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Bold V letterform -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#FFE9D5FF" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M19.5 22 L27.5 22 L32 38.5 L36.5 22 L44.5 22 L35.5 50 L28.5 50 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Sound arcs above the V opening -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#CCFFFFFF" Thickness="2.6" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 27.4 13.5 A 6.5 6.5 0 0 1 36.6 13.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#80FFFFFF" Thickness="2.6" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 24.6 16.5 A 10.5 10.5 0 0 1 39.4 16.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════ UTILITY UI ICONS ═══════════════════ -->

    <!-- Close button icon - X mark -->
    <DrawingImage x:Key="VM_Close">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFEEEEFF" Thickness="2" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5 5 L19 19 M19 5 L5 19"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Minimize button icon - Horizontal line -->
    <DrawingImage x:Key="VM_Minimize">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFEEEEFF" Thickness="2" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5 12 L19 12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Maximize button icon - Square outline -->
    <DrawingImage x:Key="VM_Maximize">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFEEEEFF" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="5 5 14 14" RadiusX="1.5" RadiusY="1.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Restore button icon - Overlapping squares -->
    <DrawingImage x:Key="VM_Restore">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Back window -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFEEEEFF" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="9 3 11 11" RadiusX="1" RadiusY="1"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Front window -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFEEEEFF" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="4 9 11 11" RadiusX="1" RadiusY="1"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════ SIDEBAR NAV ICONS (monoline, 24-grid) ═══════════════════
         Single-color stroke geometries (M0,0 M24,24 anchored bounding box),
         recolored via the nav RadioButton foreground. -->
    <PathGeometry x:Key="GeoNavVoices" Figures="M0,0 M24,24 M9.4,5.8 A2.6,2.6,0,0,1,12,3.2 A2.6,2.6,0,0,1,14.6,5.8 L14.6,10.4 A2.6,2.6,0,0,1,12,13 A2.6,2.6,0,0,1,9.4,10.4 Z M6.2,11.4 A5.8,5.8,0,0,0,17.8,11.4 M12,17.2 L12,20.2 M8.8,20.4 L15.2,20.4"/>
    <PathGeometry x:Key="GeoNavSettings" Figures="M0,0 M24,24 M8.6,12 A3.4,3.4,0,1,0,15.4,12 A3.4,3.4,0,1,0,8.6,12 Z M12,2.9 L12,5.5 M12,18.5 L12,21.1 M2.9,12 L5.5,12 M18.5,12 L21.1,12 M5.6,5.6 L7.5,7.5 M16.5,16.5 L18.4,18.4 M18.4,5.6 L16.5,7.5 M7.5,16.5 L5.6,18.4"/>
    <PathGeometry x:Key="GeoNavAbout" Figures="M0,0 M24,24 M3.5,12 A8.5,8.5,0,1,0,20.5,12 A8.5,8.5,0,1,0,3.5,12 Z M12,11 L12,16.2 M10.95,7.9 A1.05,1.05,0,1,0,13.05,7.9 A1.05,1.05,0,1,0,10.95,7.9 Z"/>
        <PathGeometry x:Key="GeoNavRecording" Figures="M0,0 M24,24 M12,4 A8,8,0,1,0,12,20 A8,8,0,1,0,12,4 Z M12,8.4 A3.6,3.6,0,1,0,12,15.6 A3.6,3.6,0,1,0,12,8.4 Z"/>
        <PathGeometry x:Key="GeoNavSoundboard" Figures="M0,0 M24,24 M4,4 L11,4 L11,11 L4,11 Z M13,4 L20,4 L20,11 L13,11 Z M4,13 L11,13 L11,20 L4,20 Z M13,13 L20,13 L20,20 L13,20 Z"/>

</ResourceDictionary>
