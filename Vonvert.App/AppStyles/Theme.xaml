<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════ COLOR TOKENS (Aurora Dark defaults — violet-night brand) ═══════════════════ -->
    <Color x:Key="C_Bg">#FF12101E</Color>
    <Color x:Key="C_Surface">#FF191627</Color>
    <Color x:Key="C_SurfaceLift">#FF211D33</Color>
    <Color x:Key="C_Border">#FF2F2A48</Color>
    <Color x:Key="C_Accent">#FF8B5CF6</Color>
    <Color x:Key="C_TextPrimary">#FFF3F1FB</Color>
    <Color x:Key="C_TextSub">#FF8B87A8</Color>
    <Color x:Key="C_Warning">#FFFBBF24</Color>

    <!-- Layout tokens -->
    <Color x:Key="C_TileSurface">#FF1A1729</Color>
    <Color x:Key="C_TileSelected">#FF252041</Color>
    <Color x:Key="C_PowerOn">#FF34D399</Color>
    <Color x:Key="C_PowerOff">#FFFB7185</Color>

    <!-- Control tokens (for Controls.xaml) -->
    <Color x:Key="C_CtrlBorder">#FF37315A</Color>
    <Color x:Key="C_CtrlSurface">#FF1E1A30</Color>
    <Color x:Key="C_CtrlText">#FFD6D2E8</Color>
    <Color x:Key="C_CtrlHover">#FF282344</Color>

    <!-- Mini toggle (Hear Myself) tokens -->
    <Color x:Key="C_ToggleOffTrack">#FF37315A</Color>
    <Color x:Key="C_ToggleOffThumb">#FF736C99</Color>

    <SolidColorBrush x:Key="Bg"          Color="{StaticResource C_Bg}"/>
    <SolidColorBrush x:Key="Surface"     Color="{StaticResource C_Surface}"/>
    <SolidColorBrush x:Key="SurfaceLift" Color="{StaticResource C_SurfaceLift}"/>
    <SolidColorBrush x:Key="Border"      Color="{StaticResource C_Border}"/>
    <SolidColorBrush x:Key="Accent"      Color="{StaticResource C_Accent}"/>
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource C_TextPrimary}"/>
    <SolidColorBrush x:Key="TextSub"     Color="{StaticResource C_TextSub}"/>
    <SolidColorBrush x:Key="Warning"     Color="{StaticResource C_Warning}"/>

    <SolidColorBrush x:Key="TileSurface" Color="{StaticResource C_TileSurface}"/>
    <SolidColorBrush x:Key="TileSelected" Color="{StaticResource C_TileSelected}"/>
    <SolidColorBrush x:Key="PowerOn"     Color="{StaticResource C_PowerOn}"/>
    <SolidColorBrush x:Key="PowerOff"    Color="{StaticResource C_PowerOff}"/>

    <!-- Control brushes -->
    <SolidColorBrush x:Key="CtrlBorder"    Color="{StaticResource C_CtrlBorder}"/>
    <SolidColorBrush x:Key="CtrlSurface"   Color="{StaticResource C_CtrlSurface}"/>
    <SolidColorBrush x:Key="CtrlText"      Color="{StaticResource C_CtrlText}"/>
    <SolidColorBrush x:Key="CtrlHover"     Color="{StaticResource C_CtrlHover}"/>

    <!-- Mini toggle brushes -->
    <SolidColorBrush x:Key="ToggleOffTrack" Color="{StaticResource C_ToggleOffTrack}"/>
    <SolidColorBrush x:Key="ToggleOffThumb" Color="{StaticResource C_ToggleOffThumb}"/>

    <!-- ═══════════════════ TYPOGRAPHY ═══════════════════ -->
    <FontFamily x:Key="FontFallback">Segoe UI, Nirmala UI, Leelawadee UI, Arial, Tahoma, sans-serif</FontFamily>

    <!-- ═══════════════════ GRADIENTS (Brand: violet → magenta) ═══════════════════ -->
    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8B5CF6" Offset="0"/>
        <GradientStop Color="#FFEC4899" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF191627" Offset="0"/>
        <GradientStop Color="#FF12101E" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VUMeterGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF34D399" Offset="0"/>
        <GradientStop Color="#FFFBBF24" Offset="0.7"/>
        <GradientStop Color="#FFFB7185" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ComboSelectedGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF252041" Offset="0"/>
        <GradientStop Color="#FF2B2550" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
