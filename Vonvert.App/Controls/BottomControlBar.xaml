<UserControl x:Class="Vonvert.App.Controls.BottomControlBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vonvert.App.UIServices"
             xmlns:vc="clr-namespace:Vonvert.App.Controls">
    <Border x:Name="BottomBorder" Background="{DynamicResource Surface}"
            CornerRadius="0,0,16,0"
            AutomationProperties.Name="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=AccBottomBar}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Gradient line -->
                <RowDefinition Height="*"/>     <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Top gradient separator -->
            <Border Grid.Row="0" Height="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#008B5CF6" Offset="0"/>
                        <GradientStop Color="#FF8B5CF6" Offset="0.3"/>
                        <GradientStop Color="#FF00CEC9" Offset="0.7"/>
                        <GradientStop Color="#0000CEC9" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Content row: brand/status | voice toggle | VU+latency -->
            <Grid Grid.Row="1" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>     <!-- Brand + Status -->
                    <ColumnDefinition Width="Auto"/>  <!-- Voice Toggle Pill -->
                    <ColumnDefinition Width="Auto"/>  <!-- VU + Latency -->
                </Grid.ColumnDefinitions>

                <!-- Left: Brand + Status (clipped at narrow widths) -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Hidden" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource VM_BrandMark}" Width="16" Height="16"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border Width="1" Height="16" Background="{DynamicResource Border}" Margin="10,0"
                            VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=AppName, Mode=OneWay}"
                                       FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                       FontFamily="{StaticResource FontFallback}" VerticalAlignment="Center"/>
                            <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=VoiceChanger, Mode=OneWay}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSub}"
                                       FontFamily="{StaticResource FontFallback}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <vc:SelectableTextBlock x:Name="StatusLabel"
                                       Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Stopped, Mode=OneWay}"
                                       FontSize="9" Foreground="{DynamicResource TextSub}"/>
                            <vc:SelectableTextBlock Text=" · " FontSize="9" Foreground="{DynamicResource TextSub}"/>
                            <!-- VB-Cable status: plain text when a virtual cable is detected,
                                 a clickable install link (opens the VB-Audio download page)
                                 when none is found. Visibility is toggled by MainWindow.CheckVBCable. -->
                            <vc:SelectableTextBlock x:Name="VBCableStatus" FontSize="9" Foreground="{DynamicResource TextSub}" Visibility="Collapsed"/>
                            <TextBlock x:Name="VBCableLink" FontSize="9" VerticalAlignment="Center" Visibility="Collapsed">
                                <Hyperlink x:Name="VBCableHyperlink" Click="VBCableHyperlink_Click"
                                           Foreground="{DynamicResource Warning}" TextDecorations="{x:Null}"><Run x:Name="VBCableLinkText"/></Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <!-- Update available badge -->
                    <Border x:Name="UpdateBadge" Visibility="Collapsed"
                            CornerRadius="10" Padding="8,2" Margin="8,0,0,0"
                            Cursor="Hand" MouseLeftButtonDown="UpdateBadge_Click"
                            ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=UpdateBadgeTip}">
                        <Border.Background>
                            <SolidColorBrush Color="#148B5CF6"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#4D8B5CF6"/>
                        </Border.BorderBrush>
                        <vc:SelectableTextBlock x:Name="UpdateBadgeText" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#FFA78BFA" VerticalAlignment="Center"/>
                    </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Center: Voice Toggle Pill -->
                <Button x:Name="VoiceToggleBtn" Grid.Column="1"
                        Style="{StaticResource VoiceToggleStyle}"
                        Click="OnEngineToggle"
                        VerticalAlignment="Center"
                        MinWidth="150"
                        Margin="12,0,44,0"
                        AutomationProperties.Name="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=AccPowerToggle}">
                    <!-- Plain text is non-interactive; IsHitTestVisible=False keeps the whole button area clickable -->
                    <TextBlock x:Name="VoiceToggleLabel"
                               Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=VoiceToggle, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#FF9CA3AF"
                               FontFamily="{StaticResource FontFallback}"
                               IsHitTestVisible="False"/>
                </Button>

                <!-- Right: VU + Latency -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                    <!-- VU bars -->
                    <Grid Margin="0,0,0,3" Width="120">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=VuIn, Mode=OneWay}"
                                   FontSize="9" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Height="6" CornerRadius="3" Background="{DynamicResource SurfaceLift}">
                            <Border x:Name="InputVUBottom" Height="6" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                                <Border.Background><DynamicResource ResourceKey="VUMeterGrad"/></Border.Background>
                            </Border>
                        </Border>
                    </Grid>
                    <Grid Margin="0,0,0,4" Width="120">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=VuOut, Mode=OneWay}"
                                   FontSize="9" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Height="6" CornerRadius="3" Background="{DynamicResource SurfaceLift}">
                            <Border x:Name="OutputVUBottom" Height="6" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                                <Border.Background><DynamicResource ResourceKey="AccentGrad"/></Border.Background>
                            </Border>
                        </Border>
                    </Grid>
                    <!-- Latency badge card -->
                    <Border HorizontalAlignment="Right" Background="{DynamicResource SurfaceLift}"
                            CornerRadius="6" Padding="8,3">
                        <vc:SelectableTextBlock x:Name="LatencyLabel"
                                   Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=LatencyDash, Mode=OneWay}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="{StaticResource FontFallback}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
