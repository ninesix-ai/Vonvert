<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared properties (TargetFramework, Nullable, ImplicitUsings, Platforms,
       AllowUnsafeBlocks, AssemblyVersion, FileVersion, Version) come from Directory.Build.props -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!--
      xUnit1031 (blocking .Result/.Wait() in tests) is suppressed deliberately:
      the concurrency suites assert deterministic interleavings that require
      synchronous blocking on completed/failed tasks; async/await would change
      the scheduling under test.
    -->
    <NoWarn>$(NoWarn);xUnit1031</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Vonvert.Engine\Vonvert.Engine.csproj" />
    <ProjectReference Include="..\..\..\Vonvert.App\Vonvert.App.csproj" />
  </ItemGroup>
</Project>
