<!-- Left icon rail (Plan B). Logo + two nav buttons (Voice Change / Settings).
     Tab switching is Checked-driven (keyboard + UI automation safe); selection
     sync from the window is done via SetSelected() with a re-entry guard. -->
<UserControl x:Class="Vonvert.App.Controls.SidebarNavRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vonvert.App.UIServices">
    <Border Background="{DynamicResource Bg}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"
            CornerRadius="16,0,0,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Brand area (logo + wordmark) -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,16,0,14">
                <Image Source="{StaticResource VM_Logo}" Width="26" Height="26"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="BrandWordmark" FontWeight="SemiBold" FontSize="10"
                           Foreground="{DynamicResource TextSub}" Margin="0,7,0,0"
                           HorizontalAlignment="Center"
                           Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=AppName, Mode=OneWay}"/>
            </StackPanel>

            <!-- Divider between the brand and nav areas -->
            <Border Grid.Row="0" Height="1" Margin="12,0" VerticalAlignment="Bottom"
                    Background="{DynamicResource Border}" IsHitTestVisible="False">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00FFFFFF"/>
                        <GradientStop Offset="0.5" Color="#FFFFFFFF"/>
                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>

            <!-- Nav area (Voice Change / Settings / About) -->
            <StackPanel x:Name="NavRail" Grid.Row="1" Width="76" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Margin="0,10,0,0">
                <RadioButton x:Name="NavVoicesBtn" Style="{StaticResource NavSideVoices}" IsChecked="True"
                             Checked="NavTab_Checked" Margin="0,0,0,6"
                             AutomationProperties.Name="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=NavVoices, Mode=OneWay}"
                             ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=NavVoices, Mode=OneWay}">
                    <StackPanel>
                        <Grid Width="38" Height="38" HorizontalAlignment="Center">
                            <Border CornerRadius="11" Opacity="0.15"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <Path Data="{StaticResource GeoNavVoices}" Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <TextBlock x:Name="NavVoicesLbl" Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="10"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="68"
                                   Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=NavVoices, Mode=OneWay}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavSoundboardBtn" Style="{StaticResource NavSideSoundboard}"
                             Checked="NavTab_Checked" Margin="0,0,0,6"
                             AutomationProperties.Name="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=NavSoundboard, Mode=OneWay}"
                             ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=NavSoundboard, Mode=OneWay}">
                    <StackPanel>
                        <Grid Width="38" Height="38" HorizontalAlignment="Center">
                            <Border CornerRadius="11" Opacity="0.15"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <Path Data="{StaticResource GeoNavSoundboard}" Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <TextBlock x:Name="NavSoundboardLbl" Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="10"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="68"
                                   Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=NavSoundboard, Mode=OneWay}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavRecordingBtn" Style="{StaticResource NavSideRecording}"
                             Checked="NavTab_Checked" Margin="0,0,0,6"
                             AutomationProperties.Name="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=NavRecording, Mode=OneWay}"
                             ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=NavRecording, Mode=OneWay}">
                    <StackPanel>
                        <Grid Width="38" Height="38" HorizontalAlignment="Center">
                            <Border CornerRadius="11" Opacity="0.15"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <Path Data="{StaticResource GeoNavRecording}" Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <TextBlock x:Name="NavRecordingLbl" Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="10"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="68"
                                   Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=NavRecording, Mode=OneWay}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavSettingsBtn" Style="{StaticResource NavSideSettings}"
                             Checked="NavTab_Checked" Margin="0,0,0,6"
                             AutomationProperties.Name="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=NavSettings, Mode=OneWay}"
                             ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=NavSettings, Mode=OneWay}">
                    <StackPanel>
                        <Grid Width="38" Height="38" HorizontalAlignment="Center">
                            <Border CornerRadius="11" Opacity="0.15"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <Path Data="{StaticResource GeoNavSettings}" Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <TextBlock x:Name="NavSettingsLbl" Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="10"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="68"
                                   Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=NavSettings, Mode=OneWay}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavAboutBtn" Style="{StaticResource NavSideAbout}"
                             Checked="NavTab_Checked" Margin="0,0,0,6"
                             AutomationProperties.Name="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=NavAbout, Mode=OneWay}"
                             ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=NavAbout, Mode=OneWay}">
                    <StackPanel>
                        <Grid Width="38" Height="38" HorizontalAlignment="Center">
                            <Border CornerRadius="11" Opacity="0.15"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <Path Data="{StaticResource GeoNavAbout}" Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <TextBlock x:Name="NavAboutLbl" Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="10"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="68"
                                   Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=NavAbout, Mode=OneWay}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>