<!-- Soundboard tab: category filter chips + import/volume toolbar, and a wrapping
     grid of one-shot pads. Pads are rendered from a bound SoundPadVM collection via
     a DataTemplate (mirrors RecordingViewControl's design-system usage). -->
<UserControl x:Class="Vonvert.App.SoundboardViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vonvert.App.UIServices">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- Category filter chip (pill RadioButton). -->
        <Style x:Key="SbChip" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="11" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource SurfaceLift}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode chip (audition / live). Deliberately NOT the category chip: the mode
             answer ("can anyone else hear me?") must be readable without reading the
             label, so the checked state carries a semantic hue instead of the decorative
             Accent purple that All/Drums/Tones use. Role is declared via Tag so one style
             covers both chips and the hue cannot be mixed up. -->
        <Style x:Key="SbModeChip" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="11" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource SurfaceLift}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="SbModeLive">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="Tag" Value="SbModeLive"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource WarnWashBrush}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Warning}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="Tag" Value="SbModeAudition"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource OkWashBrush}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PowerOn}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PowerOn}"/>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hotkey badge button (pill). -->
        <Style x:Key="SbBadge" TargetType="Button">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="7" Padding="5,1" MinWidth="34"
                                Background="{DynamicResource SurfaceLift}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete (user-imported pad) ghost button: no default chrome, destructive hover. -->
        <Style x:Key="SbDelete" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource PowerOff}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SbPad now lives in the shared AppStyles/SoundboardPadStyles.xaml (merged at App
             level) so the docked tab and the floating mini-player render identical cards. -->
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: filter chips + import/volume, and contextual hint line. -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Padding="12,10" Margin="0,0,0,0">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <RadioButton x:Name="ModeAuditionChip" Style="{StaticResource SbModeChip}" Tag="SbModeAudition"
                                     GroupName="SbMode" VerticalAlignment="Center" Margin="0,0,6,0"
                                     Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=SoundboardModeAudition, Mode=OneWay}"
                                     Checked="OnModeAudition_Checked"/>
                        <RadioButton x:Name="ModeLiveChip" Style="{StaticResource SbModeChip}" Tag="SbModeLive"
                                     GroupName="SbMode" VerticalAlignment="Center" Margin="0,0,12,0"
                                     Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=SoundboardModeLive, Mode=OneWay}"
                                     Checked="OnModeLive_Checked"/>
                        <Button x:Name="FloatBtn" Style="{StaticResource OutlineButton}"
                                Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FloatingToggle, Mode=OneWay}"
                                Click="Float_Click" Padding="10,4" FontSize="11" Margin="0,0,10,0"
                                FontFamily="{StaticResource FontFallback}"
                                ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FloatingOpen, Mode=OneWay}"/>
                        <Button x:Name="ImportBtn" Style="{StaticResource OutlineButton}"
                                Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ImportSound, Mode=OneWay}"
                                Click="Import_Click" Padding="10,4" FontSize="11" Margin="0,0,10,0"
                                FontFamily="{StaticResource FontFallback}"/>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSub}" FontSize="11"
                                   Margin="0,0,6,0" FontFamily="{StaticResource FontFallback}"
                                   Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=SoundboardVolume, Mode=OneWay}"/>
                        <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="1" Value="0.35"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=SoundboardVolume, Mode=OneWay}"/>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ChipPanel" Orientation="Horizontal"/>
                    </ScrollViewer>
                </DockPanel>
                <!-- Permanent mode status bar. It replaces both the 4-second live-mode toast
                     and the old conditional EngineHint line: exactly one sentence is always
                     on screen, so "can anyone else hear me?" is answerable at a glance instead
                     of being remembered. The code-behind only writes SbStatusBar.Tag (the
                     SoundboardStatusPolicy chip selector) and SbStatusText.Text - every colour
                     below keys off that Tag, so the hue cannot drift from the wording. -->
                <Border x:Name="SbStatusBar" Margin="0,8,0,0" CornerRadius="10"
                        BorderThickness="1" Padding="10,7">
                    <!-- Neutral colours are style SETTERS, not local attributes: a local value
                         would outrank the DataTriggers below and pin the bar grey forever. -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SurfaceLift}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorder}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, ElementName=SbStatusBar}" Value="SbModeLive">
                                    <Setter Property="Background" Value="{DynamicResource WarnWashBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Warning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tag, ElementName=SbStatusBar}" Value="SbModeAudition">
                                    <Setter Property="Background" Value="{DynamicResource OkWashBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PowerOn}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="True">
                        <Button x:Name="SbSwitchToAuditionBtn" DockPanel.Dock="Right"
                                Padding="8,3" FontSize="10"
                                Margin="10,0,0,0" VerticalAlignment="Center"
                                Click="SwitchToAudition_Click"
                                Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=SoundboardSwitchToAudition, Mode=OneWay}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, ElementName=SbStatusBar}" Value="SbModeAudition">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- The sentence itself carries the hue, not just the frame: reading
                             the colour is faster than reading the words, and this is the one
                             label in the header whose colour is a warning rather than a
                             decoration. Foreground is a style setter so the triggers below can
                             win over the neutral default. -->
                        <TextBlock x:Name="SbStatusText" FontSize="11" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontFallback}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, ElementName=SbStatusBar}" Value="SbModeLive">
                                            <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tag, ElementName=SbStatusBar}" Value="SbModeAudition">
                                            <Setter Property="Foreground" Value="{DynamicResource PowerOn}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Border>
                <TextBlock x:Name="CaptureHint" Margin="0,8,0,0" FontSize="11" Visibility="Collapsed"
                           Foreground="{DynamicResource Accent}" FontFamily="{StaticResource FontFallback}"
                           Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=SoundboardHotkeyPrompt, Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <!-- Pad grid. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,12,12,12">
            <ItemsControl x:Name="PadList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SbPad}"
                                ToolTip="{Binding DurationText}"
                                MouseLeftButtonUp="Pad_Up"
                                MouseRightButtonUp="Pad_ClearHotkey">
                            <Grid>
                                <StackPanel>
                                    <!-- Emoji glyph painted as a category-tinted silhouette. This window is
                                         layered (AllowsTransparency), where WPF drops COLR color glyphs, so a
                                         theme-token hue - not the artwork - carries the category grouping.
                                         DataTriggers keep it reactive to a future theme swap. -->
                                    <TextBlock Text="{Binding Emoji}"
                                               Style="{StaticResource SbEmojiCategory}"
                                               FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                    <!-- Name with the tiered duration inlined (Kick · 50ms): text flow,
                                         so no overlay can ever collide with emoji or badges. -->
                                    <TextBlock FontSize="10" TextWrapping="Wrap"
                                               TextAlignment="Center" MaxHeight="28" LineHeight="13"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="{StaticResource FontFallback}" Margin="0,0,0,5">
                                        <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DurationText, Mode=OneWay}" Foreground="{DynamicResource TextSub}"/>
                                    </TextBlock>
                                    <Button Style="{StaticResource SbBadge}" Content="{Binding BadgeText}"
                                            ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=AssignHotkey, Mode=OneWay}"
                                            Click="Bind_Click"/>
                                </StackPanel>
                                <Button Style="{StaticResource SbPin}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"
                                        Click="Pin_Click"
                                        ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=SoundboardPin, Mode=OneWay}"/>
                                <Button Content="&#x2715;" Style="{StaticResource SbDelete}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,26,0"
                                        Click="Delete_Click"
                                        ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=RemoveSound, Mode=OneWay}"
                                        Visibility="{Binding IsUser, Converter={StaticResource B2V}}"/>
                                <!-- Playing indicator: gradient badge mirroring the preset-tile selected language (top-left to avoid the delete button) -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0"
                                        Width="18" Height="18" CornerRadius="9"
                                        Visibility="{Binding IsPlaying, Converter={StaticResource B2V}}">
                                    <Border.Background>
                                        <DynamicResource ResourceKey="AccentGrad"/>
                                    </Border.Background>
                                    <TextBlock Text="&#x25B6;" FontSize="8" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
