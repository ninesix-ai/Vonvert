<UserControl x:Class="Vonvert.App.SettingsMyPersonaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Self-contained settings card, matching the other Settings groups (Surface
       background + themed TextSub headings) so it stays legible under any theme. -->
  <Border x:Name="Card"
          Background="{DynamicResource Surface}"
          BorderBrush="{DynamicResource Border}" BorderThickness="1"
          CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
    <StackPanel>
      <TextBlock x:Name="Title" FontSize="11" FontWeight="Bold"
                 Foreground="{DynamicResource TextSub}" Margin="0,0,0,10"
                 FontFamily="{StaticResource FontFallback}"/>
      <TextBlock x:Name="RoleLabel" FontSize="11"
                 Foreground="{DynamicResource TextSub}" Margin="0,0,0,4"
                 FontFamily="{StaticResource FontFallback}"/>
      <ComboBox x:Name="RoleCombo" Margin="0,0,0,10" SelectionChanged="RoleCombo_Changed"/>
      <TextBlock x:Name="ComplexityLabel" FontSize="11"
                 Foreground="{DynamicResource TextSub}" Margin="0,0,0,4"
                 FontFamily="{StaticResource FontFallback}"/>
      <ComboBox x:Name="ComplexityCombo" SelectionChanged="ComplexityCombo_Changed"/>
    </StackPanel>
  </Border>
</UserControl>
