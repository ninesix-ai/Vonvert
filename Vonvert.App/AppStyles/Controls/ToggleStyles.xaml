<!-- Toggle and segment styles: MiniToggle, SegmentButton, SegmentButtonActive,
     VoiceToggleStyle -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════ TOGGLE SWITCH (mini pill — Hear Myself) ═══════════════════ -->
    <Style x:Key="MiniToggle" TargetType="ToggleButton">
        <Setter Property="Width"  Value="48"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="track" CornerRadius="12"
                                Background="{DynamicResource ToggleOffTrack}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
                        <Border x:Name="thumb" Width="18" Height="18" CornerRadius="9"
                                Background="{DynamicResource ToggleOffThumb}"
                                Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border.RenderTransform><TranslateTransform x:Name="thumbMove" X="0"/></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background">
                                <Setter.Value>
                                    <DynamicResource ResourceKey="AccentGrad"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="track" Property="BorderBrush"   Value="#8B5CF6"/>
                            <Setter TargetName="thumb" Property="Background"    Value="White"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="thumbMove"
                                                         Storyboard.TargetProperty="X"
                                                         To="24" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="thumbMove"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="#8B5CF6"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════ SEGMENT BUTTON ═══════════════════ -->
    <!-- Inactive segment -->
    <Style x:Key="SegmentButton" TargetType="Button">
        <Setter Property="MinWidth"      Value="48"/>
        <Setter Property="Padding"       Value="14,5"/>
        <Setter Property="FontSize"      Value="11"/>
        <Setter Property="FontWeight"    Value="Normal"/>
        <Setter Property="Foreground"    Value="{DynamicResource TextSub}"/>
        <Setter Property="Background"    Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"        Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="segBg" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="segBg" Property="Background" Value="{DynamicResource SurfaceLift}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Active (selected) segment -->
    <Style x:Key="SegmentButtonActive" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="Foreground"  Value="White"/>
        <Setter Property="Background"  Value="{DynamicResource Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="segBg" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════ VOICE TOGGLE PILL (BOTTOM BAR) ═══════════════════ -->
    <Style x:Key="VoiceToggleStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFallback}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="pill" CornerRadius="20"
                            Background="{DynamicResource CtrlSurface}" BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                            Padding="20,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="dot" Width="10" Height="10" Fill="{DynamicResource TextSub}" Margin="0,0,8,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pill" Property="BorderBrush" Value="#308B5CF6"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="pill" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
