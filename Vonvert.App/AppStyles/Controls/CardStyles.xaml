<!-- Card and tile styles: PresetTile -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════ VOICE TILE ═══════════════════ -->
    <Style x:Key="PresetTile" TargetType="Button">
        <Setter Property="Width"           Value="{DynamicResource presetTile.width}"/>
        <Setter Property="Height"          Value="{DynamicResource presetTile.height}"/>
        <Setter Property="Margin"          Value="{DynamicResource presetTile.margin}"/>
        <Setter Property="Background"      Value="{DynamicResource TileSurface}"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontFamily"      Value="{StaticResource FontFallback}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Border}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="tile"
                            CornerRadius="{DynamicResource presetTile.cornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="4,3">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="tileIcon" Text="{TemplateBinding Content}"
                                       FontSize="{DynamicResource presetTile.iconSize}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,2"/>
                            <TextBlock x:Name="tileName"
                                       FontSize="{DynamicResource presetTile.fontSize}"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{DynamicResource TextSub}"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="{DynamicResource presetTile.maxTextWidth}"
                                       FontFamily="{StaticResource FontFallback}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tile" Property="Background" Value="{DynamicResource CtrlHover}"/>
                            <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource CtrlBorder}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
