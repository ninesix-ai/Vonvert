<!-- Floating mini-player: an always-on-top, taskbar-hidden window showing ONLY the pads
     the user pinned. Shares the pad card styles (SbPad / SbEmojiCategory / SbPin) merged
     at App level, so its cards render identically to the docked tab. -->
<Window x:Class="Vonvert.App.FloatingSoundboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Vonvert.App.UIServices"
        Title="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FloatSbTitle, Mode=OneWay}"
        Width="360" Height="440" MinWidth="260" MinHeight="200"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Background="{DynamicResource Bg}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Read-only mode band: reuses SoundboardStatusPolicy so "can anyone hear me?"
                 is answerable in the float too. The view holds no state rules. -->
            <Border x:Name="StatusBand" Grid.Row="0" CornerRadius="8" Padding="8,5" Margin="0,0,0,8"
                    BorderThickness="1" Background="{DynamicResource SurfaceLift}"
                    BorderBrush="{DynamicResource Border}">
                <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <ItemsControl x:Name="PadList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SbPad}"
                                        ToolTip="{Binding DurationText}"
                                        MouseLeftButtonUp="Pad_Up">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Emoji}"
                                                       Style="{StaticResource SbEmojiCategory}"
                                                       FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                            <TextBlock FontSize="10" TextWrapping="Wrap" TextAlignment="Center"
                                                       MaxHeight="28" LineHeight="13" Margin="0,0,0,5"
                                                       Foreground="{DynamicResource TextPrimary}">
                                                <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DurationText, Mode=OneWay}" Foreground="{DynamicResource TextSub}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Style="{StaticResource SbPin}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"
                                                Click="Unpin_Click"
                                                ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=SoundboardUnpin, Mode=OneWay}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyHint" Visibility="Collapsed" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSub}" FontSize="12"
                               Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FloatSbEmpty, Mode=OneWay}"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
