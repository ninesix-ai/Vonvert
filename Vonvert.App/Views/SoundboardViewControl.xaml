<!-- Soundboard tab: category filter chips + import/volume toolbar, and a wrapping
     grid of one-shot pads. Pads are rendered from a bound SoundPadVM collection via
     a DataTemplate (mirrors RecordingViewControl's design-system usage). -->
<UserControl x:Class="Vonvert.App.SoundboardViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vonvert.App.UIServices">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- Category filter chip (pill RadioButton). -->
        <Style x:Key="SbChip" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="11" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource SurfaceLift}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hotkey badge button (pill). -->
        <Style x:Key="SbBadge" TargetType="Button">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="7" Padding="5,1" MinWidth="34"
                                Background="{DynamicResource SurfaceLift}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete (user-imported pad) ghost button: no default chrome, destructive hover. -->
        <Style x:Key="SbDelete" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource PowerOff}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pad card: hover + playing feedback. Metrics mirror PresetTile (voice page):
             corner 10, TileSurface bg, CtrlHover/CtrlBorder on hover, Accent ring when active. -->
        <Style x:Key="SbPad" TargetType="Border">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource TileSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorder}"/>
                    <Setter Property="Background" Value="{DynamicResource CtrlHover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentGrad}"/>
                    <Setter Property="Background" Value="{DynamicResource CtrlHover}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: filter chips + import/volume, and contextual hint line. -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Padding="12,10" Margin="0,0,0,0">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="ImportBtn" Style="{StaticResource OutlineButton}"
                                Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ImportSound, Mode=OneWay}"
                                Click="Import_Click" Padding="10,4" FontSize="11" Margin="0,0,10,0"
                                FontFamily="{StaticResource FontFallback}"/>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSub}" FontSize="11"
                                   Margin="0,0,6,0" FontFamily="{StaticResource FontFallback}"
                                   Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=SoundboardVolume, Mode=OneWay}"/>
                        <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="1" Value="0.35"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=SoundboardVolume, Mode=OneWay}"/>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ChipPanel" Orientation="Horizontal"/>
                    </ScrollViewer>
                </DockPanel>
                <TextBlock x:Name="EngineHint" Margin="0,8,0,0" FontSize="11" Visibility="Collapsed"
                           Foreground="{DynamicResource Warning}" FontFamily="{StaticResource FontFallback}"
                           Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=SoundboardEngineHint, Mode=OneWay}"/>
                <TextBlock x:Name="CaptureHint" Margin="0,8,0,0" FontSize="11" Visibility="Collapsed"
                           Foreground="{DynamicResource Accent}" FontFamily="{StaticResource FontFallback}"
                           Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=SoundboardHotkeyPrompt, Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <!-- Pad grid. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,12,12,12">
            <ItemsControl x:Name="PadList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SbPad}"
                                MouseLeftButtonUp="Pad_Up"
                                MouseRightButtonUp="Pad_ClearHotkey">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding Emoji}" FontSize="22" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Margin="0,0,0,4" FontFamily="Segoe UI Emoji"/>
                                    <TextBlock Text="{Binding Name}" FontSize="10" TextWrapping="Wrap"
                                               TextAlignment="Center" MaxHeight="28" LineHeight="13"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="{StaticResource FontFallback}" Margin="0,0,0,5"/>
                                    <Button Style="{StaticResource SbBadge}" Content="{Binding BadgeText}"
                                            ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=AssignHotkey, Mode=OneWay}"
                                            Click="Bind_Click"/>
                                </StackPanel>
                                <Button Content="&#x2715;" Style="{StaticResource SbDelete}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"
                                        Click="Delete_Click"
                                        ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=RemoveSound, Mode=OneWay}"
                                        Visibility="{Binding IsUser, Converter={StaticResource B2V}}"/>
                                <!-- Playing indicator: gradient badge mirroring the preset-tile selected language (top-left to avoid the delete button) -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0"
                                        Width="18" Height="18" CornerRadius="9"
                                        Visibility="{Binding IsPlaying, Converter={StaticResource B2V}}">
                                    <Border.Background>
                                        <DynamicResource ResourceKey="AccentGrad"/>
                                    </Border.Background>
                                    <TextBlock Text="&#x25B6;" FontSize="8" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
