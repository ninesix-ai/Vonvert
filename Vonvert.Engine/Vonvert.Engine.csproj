<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared properties (TargetFramework, Nullable, ImplicitUsings, Platforms,
       AllowUnsafeBlocks, AssemblyVersion, FileVersion, Version) come from Directory.Build.props -->
  <PropertyGroup>
    <Optimize>true</Optimize>
    <AssemblyName>Vonvert.Engine</AssemblyName>
    <RootNamespace>Vonvert.Engine</RootNamespace>
    <!-- Release provenance metadata: embedded into the assembly so binaries are
         traceable to the source repository (supply-chain / SBOM consumers). -->
    <RepositoryUrl>https://github.com/ninesix-ai/Vonvert</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/ninesix-ai/Vonvert</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- Embeds source-control provenance (commit, repo URL) into PDBs for traceable binaries.
         Enable with -p:EnableSourceLinkGitHub=true when building from the public GitHub
         repository (the local dev remote is a private monorepo, which cannot be linked). -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all"
                      Condition="'$(EnableSourceLinkGitHub)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Vonvert.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- Embedded built-in preset JSON files -->
  <ItemGroup>
    <EmbeddedResource Include="PresetLibrary\BuiltIn\*.json" LogicalName="Vonvert.Engine.PresetLibrary.BuiltIn.%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Embedded DSP default parameter values (JSON) -->
  <ItemGroup>
    <EmbeddedResource Include="PresetLibrary\dsp-defaults.json" LogicalName="Vonvert.Engine.PresetLibrary.dsp-defaults.json" />
  </ItemGroup>
</Project>
