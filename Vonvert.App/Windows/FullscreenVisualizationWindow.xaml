<Window x:Class="Vonvert.App.FullscreenVisualizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Vonvert.App.UIServices"
        xmlns:vc="clr-namespace:Vonvert.App.Controls"
        Title="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=AppName}"
        Width="1280" Height="720" MinWidth="640" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Black"
        ResizeMode="CanResize" Topmost="True"
        WindowStartupLocation="CenterScreen" Cursor="None">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="MainRow"    Height="*"/>
            <RowDefinition x:Name="WaveRow"    Height="140"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MainCol"  Width="*"/>
            <ColumnDefinition x:Name="LufsCol"  Width="150"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Waterfall pane (main view, pitch overlay) ══ -->
        <Border x:Name="WaterfallPanel" Grid.Row="0" Grid.Column="0" Background="Black"
                MouseLeftButtonDown="WaterfallPanel_DoubleClick">
            <Grid>
                <Image x:Name="WaterfallImage" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="Linear"/>
                <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsSpectrogram, Mode=OneWay}"
                       FontSize="12" Foreground="#55FFFFFF" Margin="10,8,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <!-- pitch badges (top-right overlay) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,20,0">
                    <Border x:Name="FsPitchNoteBadge" CornerRadius="8" Padding="14,6" Background="#558B5CF6" Margin="0,0,10,0" Visibility="Collapsed">
                        <vc:SelectableTextBlock x:Name="FsPitchNoteText" Text="—" FontSize="36" FontWeight="Bold" Foreground="#DD8B5CF6"/>
                    </Border>
                    <Border x:Name="FsPitchCentsBadge" CornerRadius="8" Padding="10,6" Background="#333EC6FF" Margin="0,0,10,0" Visibility="Collapsed">
                        <vc:SelectableTextBlock x:Name="FsPitchCentsText" Text="0 cents" FontSize="20" Foreground="#BB3EC6FF" VerticalAlignment="Center"/>
                    </Border>
                    <vc:SelectableTextBlock x:Name="FsPitchFreqText" Text="" FontSize="16" Foreground="#66FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- pitch curve + cents meter (bottom overlay inside the pane) -->
                <Canvas x:Name="PitchCurveCanvas" Height="80" VerticalAlignment="Bottom" Background="#08080E" ClipToBounds="True"/>
                <Canvas x:Name="FsCentsMeterCanvas" Height="8" VerticalAlignment="Bottom" Margin="30,0,30,84" ClipToBounds="True" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ══ Loudness pane (vertical LUFS meter) ══ -->
        <Border x:Name="LoudnessPanel" Grid.Row="0" Grid.Column="1" Background="#0A0C12"
                BorderBrush="#22FFFFFF" BorderThickness="1,0,0,0"
                MouseLeftButtonDown="LoudnessPanel_DoubleClick">
            <Grid Margin="10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <vc:SelectableTextBlock Grid.Row="0" Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsLoudness, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF"/>
                <Canvas x:Name="LufsCanvas" Grid.Row="1" ClipToBounds="True"/>
                <StackPanel Grid.Row="2">
                    <vc:SelectableTextBlock x:Name="LufsTruePeakText" Text="TP -∞" FontSize="11" Foreground="#88FFFFFF" Margin="0,6,0,0"/>
                    <vc:SelectableTextBlock x:Name="LufsIntegratedText" Text="I -∞" FontSize="12" Foreground="#BB3EC6FF" Margin="0,2,0,0">
                        <vc:SelectableTextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ResetIntegratedItem" Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsResetIntegrated, Mode=OneWay}" Click="ResetIntegrated_Click"/>
                            </ContextMenu>
                        </vc:SelectableTextBlock.ContextMenu>
                    </vc:SelectableTextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Waveform pane (dry/wet) ══ -->
        <Border x:Name="WaveformPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#0A0C12"
                BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0"
                MouseLeftButtonDown="WaveformPanel_DoubleClick">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="12,8,0,8" VerticalAlignment="Top">
                    <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsWaveform, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="DryBtn" Style="{StaticResource OutlineButton}" Padding="10,3" Margin="0,0,6,0" Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsDry, Mode=OneWay}" Click="DryBtn_Click"/>
                        <Button x:Name="WetBtn" Style="{StaticResource OutlineButton}" Padding="10,3" Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=FsWet, Mode=OneWay}" Click="WetBtn_Click"/>
                    </StackPanel>
                </StackPanel>
                <Canvas x:Name="WaveformCanvas" Grid.Column="1" Margin="8" ClipToBounds="True"/>
            </Grid>
        </Border>

        <!-- preset-name fade overlay -->
        <vc:SelectableTextBlock x:Name="PresetNameOverlay" Grid.Row="0" Grid.Column="0" FontSize="48" FontWeight="Bold"
               Foreground="#AA8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
            <vc:SelectableTextBlock.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/></vc:SelectableTextBlock.Effect>
        </vc:SelectableTextBlock>

        <!-- close hint (revealed on mouse move) -->
        <Border x:Name="CloseHint" Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Right"
                Background="#88000000" CornerRadius="0,0,0,12" Padding="16,8" Opacity="0">
            <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=EscToClose, Mode=OneWay}" FontSize="12" Foreground="#88FFFFFF"/>
        </Border>
    </Grid>
</Window>
