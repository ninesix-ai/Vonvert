<!-- Input control styles: ComboBox dark template -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════ COMBOBOX — FULL DARK TEMPLATE ═══════════════════ -->
    <ControlTemplate x:Key="DarkComboToggle" TargetType="ToggleButton">
        <Border x:Name="bd" Background="{TemplateBinding Background}"
                BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center"
                                  HorizontalAlignment="Left"/>
                <Path Grid.Column="1" x:Name="arrow"
                      Data="M0,0 L5,5 L10,0" Stroke="#8B5CF6" StrokeThickness="1.8"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="bd" Property="Background"  Value="{DynamicResource CtrlSurface}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground"         Value="{DynamicResource CtrlText}"/>
        <Setter Property="Background"         Value="Transparent"/>
        <Setter Property="Padding"            Value="12,7"/>
        <Setter Property="FontFamily"         Value="{StaticResource FontFallback}"/>
        <Setter Property="FontSize"           Value="12"/>
        <Setter Property="Cursor"             Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="4,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource CtrlHover}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <DynamicResource ResourceKey="ComboSelectedGrad"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#A89CF8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground"         Value="{DynamicResource CtrlText}"/>
        <Setter Property="Background"         Value="{DynamicResource CtrlSurface}"/>
        <Setter Property="FontFamily"         Value="{StaticResource FontFallback}"/>
        <Setter Property="FontSize"           Value="12"/>
        <Setter Property="Height"             Value="36"/>
        <Setter Property="Cursor"             Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle"
                                      Template="{StaticResource DarkComboToggle}"
                                      Background="{TemplateBinding Background}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="content"
                                          Margin="12,0,32,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Placement="Bottom" PopupAnimation="Slide"
                               MinWidth="{TemplateBinding ActualWidth}">
                            <Border Background="{DynamicResource CtrlSurface}"
                                    BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                    CornerRadius="8" Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
                                </Border.Effect>
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Padding="0,4">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
