<!-- Shared soundboard pad visual tokens used by BOTH the docked tab and the floating
     mini-player, so card size / category hue / pinned highlight cannot drift between them.
     Event handlers stay in each view's own DataTemplate; only the styles are shared here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Pad card: byte-for-byte the docked definition (96x96 square from glyph metrics,
         TileSurface bg, CtrlBorder/CtrlHover on hover, AccentGrad ring while playing),
         plus a pinned ring so both windows render identical cards. IsPlaying below wins
         the border over the pinned ring (it is the transient one). -->
    <Style x:Key="SbPad" TargetType="Border">
        <Setter Property="Width" Value="96"/>
        <Setter Property="Height" Value="96"/>
        <Setter Property="Margin" Value="0,0,14,14"/>
        <Setter Property="Padding" Value="6,6"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource TileSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorder}"/>
                <Setter Property="Background" Value="{DynamicResource CtrlHover}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentGrad}"/>
                <Setter Property="Background" Value="{DynamicResource CtrlHover}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Emoji glyph painted as a category-tinted silhouette. The window is layered, where
         WPF drops COLR color glyphs, so a theme-token hue - not the artwork - carries the
         category grouping. DataTriggers keep it reactive to a future theme swap. -->
    <Style x:Key="SbEmojiCategory" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Category}" Value="Drums"><Setter Property="Foreground" Value="{DynamicResource IconCatDrums}"/></DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Tones"><Setter Property="Foreground" Value="{DynamicResource IconCatTones}"/></DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="SFX"><Setter Property="Foreground" Value="{DynamicResource IconCatSFX}"/></DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Memes"><Setter Property="Foreground" Value="{DynamicResource IconCatMemes}"/></DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Music"><Setter Property="Foreground" Value="{DynamicResource IconCatMusic}"/></DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Retro"><Setter Property="Foreground" Value="{DynamicResource IconCatRetro}"/></DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Ambient"><Setter Property="Foreground" Value="{DynamicResource IconCatAmbient}"/></DataTrigger>
            <!-- Imported files are not a catalogue category: brand accent. -->
            <DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Pin (📌) action button: accent tint when the pad IsPinned. One style serves both
         views - the tab toggles pin/unpin, the float unpins (both call TogglePin). -->
    <Style x:Key="SbPin" TargetType="Button">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Content" Value="&#x1F4CC;"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource CtrlHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
