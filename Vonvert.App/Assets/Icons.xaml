    <PathGeometry x:Key="GeoBrandV" Figures="M4.875 5.5 L6.875 5.5 L8 9.625 L9.125 5.5 L11.125 5.5 L8.875 13.75 L7.125 13.75 Z"/>
    <DrawingImage x:Key="VM_BrandMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.ClipGeometry>
                    <RectangleGeometry Rect="0,0,16,16"/>
                </DrawingGroup.ClipGeometry>
                <!-- Bold V letterform (same brush source as the arcs so the
                     whole mark always recolors as one under any theme) -->
                <GeometryDrawing Brush="{DynamicResource TextPrimary}"
                                 Geometry="{DynamicResource GeoBrandV}"/>
                <!-- Inner sound arc -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource TextPrimary}" Thickness="0.9" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 6.85 3.0 A 1.625 1.625 0 0 1 9.15 3.0"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Outer sound arc -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource TextPrimary}" Thickness="0.65" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 6.15 4.0 A 2.625 2.625 0 0 1 9.85 4.0"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
