<!-- Card and tile styles: PresetTile -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:Vonvert.App.Controls">

    <!-- ═══════════════════ VOICE TILE ═══════════════════ -->
    <Style x:Key="PresetTile" TargetType="Button">
        <Setter Property="Width"           Value="{DynamicResource presetTile.width}"/>
        <Setter Property="Height"          Value="{DynamicResource presetTile.height}"/>
        <Setter Property="Margin"          Value="{DynamicResource presetTile.margin}"/>
        <Setter Property="Background"      Value="{DynamicResource TileSurface}"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontFamily"      Value="{StaticResource FontFallback}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Border}"/>
        <Setter Property="ctl:SelectionState.IsSelected" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="tile"
                            CornerRadius="{DynamicResource presetTile.cornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="4,3">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="tileIcon" Text="{TemplateBinding Content}"
                                           FontSize="{DynamicResource presetTile.iconSize}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,2"/>
                                <TextBlock x:Name="tileName"
                                           FontSize="{DynamicResource presetTile.fontSize}"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource TextSub}"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="{DynamicResource presetTile.maxTextWidth}"
                                           FontFamily="{StaticResource FontFallback}"/>
                            </StackPanel>
                            <!-- Unified selected check badge (top-right) -->
                            <Border x:Name="selBadge" Width="18" Height="18"
                                    CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-6,-6,0" Visibility="Collapsed">
                                <Border.Background>
                                    <DynamicResource ResourceKey="AccentGrad"/>
                                </Border.Background>
                                <TextBlock Text="&#x2713;" FontSize="11" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tile" Property="Background" Value="{DynamicResource CtrlHover}"/>
                            <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource CtrlBorder}"/>
                        </Trigger>
                        <!-- Selected overrides hover (declared later): 2px gradient border + check badge + brightened bg -->
                        <Trigger Property="ctl:SelectionState.IsSelected" Value="True">
                            <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource AccentGrad}"/>
                            <Setter TargetName="tile" Property="Background" Value="{DynamicResource CtrlHover}"/>
                            <Setter TargetName="selBadge" Property="Visibility" Value="Visible"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════ CATEGORY CHIP (Voices filter) ═══════════════════ -->
    <Style x:Key="CategoryChip" TargetType="RadioButton">
        <Setter Property="Background"      Value="{DynamicResource TileSurface}"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextSub}"/>
        <Setter Property="FontFamily"      Value="{StaticResource FontFallback}"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Height"          Value="26"/>
        <Setter Property="Margin"          Value="0,0,6,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="13" Padding="12,0"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <TextBlock x:Name="txt" Text="{TemplateBinding Content}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource CtrlBorder}"/>
                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <DynamicResource ResourceKey="AccentGrad"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="txt" Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
