<UserControl x:Class="Vonvert.App.RecordingViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vonvert.App.UIServices"
             xmlns:conv="clr-namespace:Vonvert.App.Converters"
             xmlns:vc="clr-namespace:Vonvert.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Recording Statistics -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceLift}"
                CornerRadius="8" Padding="12,8" Margin="12,8,12,4">
            <vc:SelectableTextBlock x:Name="RecStatsText"
                Text="" FontSize="11" Foreground="{DynamicResource TextSub}"
                FontFamily="{StaticResource FontFallback}"/>
        </Border>

        <!-- Recording Controls -->
        <Border Grid.Row="1" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Padding="12,10" Margin="12,0,12,4">
            <StackPanel>
                <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=RecordingTitle, Mode=OneWay}"
                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                           FontFamily="{StaticResource FontFallback}" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartRecordBtn" Style="{StaticResource OutlineButton}"
                            Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=StartRecording, Mode=OneWay}"
                            Click="StartRecord_Click" Margin="0,0,8,0"/>
                    <Button x:Name="StopRecordBtn" Style="{StaticResource OutlineButton}"
                            Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=StopRecording, Mode=OneWay}"
                            Click="StopRecord_Click" Margin="0,0,8,0"
                            Visibility="Collapsed"/>
                    <Button x:Name="CancelRecordBtn" Style="{StaticResource OutlineButton}"
                            Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=CancelRecording, Mode=OneWay}"
                            Click="CancelRecord_Click"
                            Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                            x:Name="RecordModePanel" Visibility="Collapsed">
                    <vc:SelectableTextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=RecordMode, Mode=OneWay}"
                               FontSize="11" Foreground="{DynamicResource TextSub}"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               FontFamily="{StaticResource FontFallback}"/>
                    <Button x:Name="RecordModeProcessedBtn"
                            Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=RecordModeProcessed, Mode=OneWay}"
                            Style="{StaticResource OutlineButton}"
                            Click="RecordModeProcessed_Click" Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                    <Button x:Name="RecordModeOriginalBtn"
                            Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=RecordModeOriginal, Mode=OneWay}"
                            Style="{StaticResource OutlineButton}"
                            Click="RecordModeOriginal_Click" Padding="8,4" FontSize="11"/>
                </StackPanel>
                <vc:SelectableTextBlock x:Name="RecordingStatus" Text=""
                           FontSize="11" Foreground="{DynamicResource TextSub}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Recording History -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="12,8,12,12">
            <StackPanel>
                <!-- Search + Filter Bar -->
                <Border Background="{DynamicResource SurfaceLift}" CornerRadius="8"
                        Padding="10,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBox x:Name="RecSearchBox" FontSize="12"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Background="{DynamicResource Surface}"
                                 BorderBrush="{DynamicResource Border}"
                                 FontFamily="{StaticResource FontFallback}"
                                 Tag="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=RecSearch, Mode=OneWay}"
                                 TextChanged="OnRecordingSearch_TextChanged"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                            <StackPanel x:Name="RecDateFilterPanel" Orientation="Horizontal"/>
                        </ScrollViewer>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                            <StackPanel x:Name="RecDurationFilterPanel" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <vc:SelectableTextBlock Grid.Column="0"
                               Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=RecordingHistory, Mode=OneWay}"
                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSub}"
                               FontFamily="{StaticResource FontFallback}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox x:Name="SelectAllCheckbox"
                                  Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=SelectAll, Mode=OneWay}"
                                  FontSize="11" Foreground="{DynamicResource TextSub}"
                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="SelectAll_Checked" Unchecked="SelectAll_Unchecked"/>
                        <Button x:Name="DeleteSelectedBtn" Style="{StaticResource OutlineButton}"
                                Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=DeleteSelected, Mode=OneWay}"
                                Click="DeleteSelected_Click" Padding="10,4" FontSize="11" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
                <vc:SelectableTextBlock x:Name="RecordingEmptyHint"
                           Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=EmptyRecordingHint, Mode=OneWay}"
                           FontSize="11" Foreground="{DynamicResource TextSub}" FontStyle="Italic"
                           FontFamily="{StaticResource FontFallback}"
                           HorizontalAlignment="Center" Margin="0,16,0,8"/>
                <ItemsControl x:Name="RecordingHistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Checked="HistoryItem_Checked" Unchecked="HistoryItem_Unchecked"
                                              Tag="{Binding}"/>
                                    <StackPanel Grid.Column="1">
                                        <vc:SelectableTextBlock Text="{Binding FileName, Mode=OneWay}"
                                   FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        <vc:SelectableTextBlock FontSize="11" Foreground="{DynamicResource TextSub}" Margin="0,4,0,0">
                                            <vc:SelectableTextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:F1}s • {1:F1} KB">
                                                    <Binding Path="Duration"/>
                                                    <Binding Path="FileSize" Converter="{x:Static conv:FileSizeConverter.Instance}"/>
                                                </MultiBinding>
                                            </vc:SelectableTextBlock.Text>
                                        </vc:SelectableTextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource OutlineButton}"
                                            Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ExportRecording, Mode=OneWay}"
                                            Click="ExportRecording_Click" Padding="10,4" FontSize="11" Margin="0,0,4,0"
                                            Tag="{Binding}"/>
                                    <Button Grid.Column="3" Style="{StaticResource OutlineButton}"
                                            Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=DeleteRecording, Mode=OneWay}"
                                            Click="DeleteRecording_Click" Padding="10,4" FontSize="11"
                                            Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
