<!-- Button styles: OutlineButton -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════ BUTTON - GHOST ═══════════════════ -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextSub}"/>
        <Setter Property="FontFamily"      Value="{StaticResource FontFallback}"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Padding"         Value="12,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Border}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush"  Value="{DynamicResource Accent}"/>
                            <Setter TargetName="bd" Property="Background"   Value="#1A8B5CF6"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════ NAV SIDEBAR BUTTON (Plan B icon rail) ═══════════════════
         Monoline icon + chip + label; ALL coloring is driven by Foreground:
         idle=TextSub, hover=TextPrimary, checked=<per-tab color> (derived styles
         below). The chip tint in SidebarNavRail binds to Foreground at 15%
         opacity, so one trigger recolors icon, label and chip together. -->
    <Style x:Key="NavSideBtn" TargetType="RadioButton">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextSub}"/>
        <Setter Property="FontFamily"       Value="{StaticResource FontFallback}"/>
        <Setter Property="FontWeight"       Value="SemiBold"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="GroupName"        Value="MainNav"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Per-tab checked hues: each nav tab takes a distinct accent color -->
    <Style x:Key="NavSideVoices" TargetType="RadioButton" BasedOn="{StaticResource NavSideBtn}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource IconVoices}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavSideRecording" TargetType="RadioButton" BasedOn="{StaticResource NavSideBtn}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource IconRecord}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavSideSettings" TargetType="RadioButton" BasedOn="{StaticResource NavSideBtn}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource IconSettings}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavSideAbout" TargetType="RadioButton" BasedOn="{StaticResource NavSideBtn}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource IconAbout}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
